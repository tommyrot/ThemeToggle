{
  "manifest_version": 2,
  "name": "Theme Toggle",
  "version": "1.0",
  "description": "Toggle Firefox's color scheme between Light and Dark.",
  "author": "tommyrot",
  "homepage_url": "https://github.com/tommyrot/ThemeToggle",
  "browser_specific_settings": {
    "gecko": {
      "data_collection_permissions": {
        "required": ["none"],
        "optional": []
      }
    }
  },
  "permissions": ["browserSettings", "storage"],
  "background": {
    "scripts": ["background.js"]
  },
  "browser_action": {
    "default_icon": "icon.svg",
    "default_title": "Toggle Light/Dark Theme"
  },
  "icons": {
    "48": "icon.svg"
  }
}
